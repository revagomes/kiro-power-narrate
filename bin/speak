#!/bin/bash
# speak - Convert text to speech using Piper TTS (neural, high quality, offline)
#
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Renato Vasconcellos Gomes
#
# This program is free software: you can redistribute it and/or modify it under
# the terms of the GNU General Public License as published by the Free Software
# Foundation, either version 3 of the License, or (at your option) any later
# version. See the LICENSE file for the full text.
#
# Usage:
#   speak "Hello world"
#   echo "Hello world" | speak
#   speak -s 0.6 "Faster"
#   speak -v br "Olá mundo"
#
# Speed (--length-scale; this is a TIME multiplier, lower = faster):
#   1.0 = natural / original Piper pace (default), 0.8 = brisk,
#   0.6 = fast, 0.4 = very fast
#
# Voices:
#   us (default) | br  (aliases), or any model filename (without .onnx) that
#   exists in the voices directory. A voice name may not contain a path
#   separator or "..": models are always resolved inside the voices directory.
#
# Engines: this wrapper supports BOTH Piper command-line interfaces and
# auto-detects which one is installed:
#   * legacy standalone binary (rhasspy/piper, v1.2.0): resolved as a `piper`
#     executable on PATH; takes a full --model <path.onnx> and --output_file.
#   * new piper1-gpl (OHF-Voice, >=1.3.0): a Python package run as
#     `python3 -m piper`; resolves a voice NAME via --data-dir, writes with -f,
#     and requires the text after a `--` separator.
# Override detection with PIPER_ENGINE=legacy|python.
#
# Part of the "narrate" Kiro power. No dependency on any particular project.
# Shells out to Piper and plays the result with `aplay` (Linux/ALSA) or
# `afplay` (macOS).

set -euo pipefail

VOICES_DIR="${PIPER_VOICES_DIR:-$HOME/.local/share/piper-voices}"
SPEED="1.0"   # Default: natural pace (matches piper1-gpl's length_scale default)
VOICE="us"

usage() {
    cat >&2 <<'EOF'
speak - local, offline text-to-speech via Piper

Usage:
  speak [options] "text to speak"
  echo "text" | speak [options]

Options:
  -s, --speed N    Length scale, lower = faster (default 1.0; e.g. 0.6 fast, 1.0 natural)
  -v, --voice NAME Voice alias (us|en, br|pt) or a model filename without .onnx
  -h, --help       Show this help

Voice models live in $PIPER_VOICES_DIR (default ~/.local/share/piper-voices).
Engine is auto-detected; override with PIPER_ENGINE=legacy|python.
EOF
    exit "${1:-0}"
}

# Resolve a voice alias to its canonical model name (no path, no extension),
# confined to a bare filename. Used by both engines.
resolve_voice_name() {
    local name="$1"
    case "$name" in
        us|en) name="en_US-amy-medium" ;;
        br|pt) name="pt_BR-faber-medium" ;;
    esac
    # Reject path traversal: a voice name is a bare filename, never a path.
    case "$name" in
        */*|*..*|"")
            echo "Error: invalid voice name '$1' (no path separators or '..')." >&2
            exit 2
            ;;
    esac
    printf '%s' "$name"
}

# Validate speed is a non-negative number (integer or decimal).
valid_speed() {
    case "$1" in
        ''|*[!0-9.]*) return 1 ;;
        *.*.*)        return 1 ;;  # more than one dot
        *)            return 0 ;;
    esac
}

# Parse flags.
while [[ "${1:-}" == -* ]]; do
    case "$1" in
        -s|--speed)
            [ "$#" -ge 2 ] || { echo "Error: $1 needs a value." >&2; usage 1; }
            SPEED="$2"; shift 2 ;;
        -v|--voice)
            [ "$#" -ge 2 ] || { echo "Error: $1 needs a value." >&2; usage 1; }
            VOICE="$2"; shift 2 ;;
        -h|--help) usage 0 ;;
        --)        shift; break ;;
        *)         echo "Error: unknown flag '$1'." >&2; usage 1 ;;
    esac
done

if ! valid_speed "$SPEED"; then
    echo "Error: --speed must be a non-negative number (got '$SPEED')." >&2
    exit 2
fi

# ---------------------------------------------------------------------------
# Engine detection.
#
# Produces:
#   ENGINE        : "legacy" or "python"
#   PIPER_CMD     : array, the base command to invoke Piper
# ---------------------------------------------------------------------------
PIPER_CMD=()
ENGINE=""

detect_engine() {
    # Explicit override wins.
    case "${PIPER_ENGINE:-}" in
        legacy)
            command -v piper >/dev/null 2>&1 || {
                echo "Error: PIPER_ENGINE=legacy but no 'piper' binary on PATH." >&2; exit 127; }
            ENGINE="legacy"; PIPER_CMD=(piper); return ;;
        python)
            command -v python3 >/dev/null 2>&1 || {
                echo "Error: PIPER_ENGINE=python but no 'python3' on PATH." >&2; exit 127; }
            ENGINE="python"; PIPER_CMD=(python3 -m piper); return ;;
        "") : ;;  # fall through to auto-detection
        *)  echo "Error: PIPER_ENGINE must be 'legacy' or 'python' (got '$PIPER_ENGINE')." >&2; exit 2 ;;
    esac

    # Auto-detect. The two engines have CONVERGED on flags (piper1-gpl >=1.8.0
    # accepts a model path, both --output_file and --output-file, and reads
    # stdin), so we cannot tell them apart by a single flag token. Instead,
    # positively identify piper1-gpl — it is a Python package — and treat
    # anything else that is only a `piper` binary as the legacy standalone.
    #
    #   * piper1-gpl: `import piper` succeeds AND/OR its --help advertises
    #     `--data-dir` (the voice-name resolver the legacy binary never had).
    #   * legacy 1.2.0: a compiled `piper` binary, no importable module,
    #     no `--data-dir` in help.

    # 1. If the piper1-gpl module is importable, prefer it. Use the `piper`
    #    console script when present (it is that package's own entry point),
    #    else the module form.
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import piper' >/dev/null 2>&1; then
        if command -v piper >/dev/null 2>&1 && piper --help 2>&1 | grep -q -- '--data-dir'; then
            ENGINE="python"; PIPER_CMD=(piper); return
        fi
        ENGINE="python"; PIPER_CMD=(python3 -m piper); return
    fi

    # 2. A `piper` binary whose help advertises --data-dir is piper1-gpl even if
    #    its module is not importable from this python3 (e.g. installed via uv in
    #    a separate environment that still exposes the console script).
    if command -v piper >/dev/null 2>&1; then
        if piper --help 2>&1 | grep -q -- '--data-dir'; then
            ENGINE="python"; PIPER_CMD=(piper); return
        fi
        # No --data-dir: the legacy standalone binary.
        ENGINE="legacy"; PIPER_CMD=(piper); return
    fi

    echo "Error: Piper not found. Install one of:" >&2
    echo "  pip install piper-tts        # piper1-gpl (new CLI)" >&2
    echo "  uv tool install piper-tts    # same package via uv" >&2
    echo "  or place the legacy standalone 'piper' binary on your PATH." >&2
    exit 127
}

detect_engine

VOICE_NAME="$(resolve_voice_name "$VOICE")"
MODEL="$VOICES_DIR/$VOICE_NAME.onnx"

# Both engines read the .onnx (and its .json sidecar) from $VOICES_DIR. The
# legacy binary takes the full path; the new CLI takes the name + --data-dir.
if [ ! -f "$MODEL" ]; then
    echo "Error: voice model not found: $MODEL" >&2
    echo "Available voices in $VOICES_DIR:" >&2
    found=0
    for f in "$VOICES_DIR"/*.onnx; do
        [ -e "$f" ] || continue
        name="${f##*/}"; printf '  %s\n' "${name%.onnx}" >&2
        found=1
    done
    [ "$found" -eq 1 ] || echo "  (none)" >&2
    echo "Download voices from https://huggingface.co/rhasspy/piper-voices" >&2
    echo "or, with the new CLI: python3 -m piper.download_voices $VOICE_NAME --data-dir $VOICES_DIR" >&2
    exit 1
fi

# Pick a player (afplay has no quiet flag; aplay does).
if command -v aplay >/dev/null 2>&1; then
    PLAYER=(aplay -q)
elif command -v afplay >/dev/null 2>&1; then
    PLAYER=(afplay)   # macOS
else
    echo "Error: no audio player found (need 'aplay' or 'afplay')." >&2
    exit 127
fi

TMPFILE="$(mktemp "${TMPDIR:-/tmp}/speak-XXXXXX")"
# Piper writes WAV; keep a .wav path so players sniff the format reliably.
WAVFILE="$TMPFILE.wav"
cleanup() { rm -f "$TMPFILE" "$WAVFILE"; }
trap cleanup EXIT

# Read the text: from positional args, or stdin when no args are given.
if [ "$#" -gt 0 ]; then
    TEXT="$*"
else
    TEXT="$(cat)"
fi

# Synthesize. Do not silence Piper's errors — a failed synthesis should be
# visible. --length-scale works identically on both engines.
case "$ENGINE" in
    legacy)
        # Legacy standalone binary: full model path, --output_file, text on stdin.
        printf '%s' "$TEXT" | "${PIPER_CMD[@]}" \
            --model "$MODEL" \
            --length-scale "$SPEED" \
            --output_file "$WAVFILE"
        ;;
    python)
        # piper1-gpl: voice NAME + --data-dir, -f output, text after `--`.
        "${PIPER_CMD[@]}" \
            -m "$VOICE_NAME" \
            --data-dir "$VOICES_DIR" \
            --length-scale "$SPEED" \
            -f "$WAVFILE" \
            -- "$TEXT"
        ;;
esac

# Play. Report a real failure instead of silently "succeeding".
if ! "${PLAYER[@]}" "$WAVFILE"; then
    echo "Error: playback failed (no audio device? check 'aplay -l')." >&2
    exit 1
fi
